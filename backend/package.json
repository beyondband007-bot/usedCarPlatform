{
  "name": "used-car-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "backfill:thumbnails": "tsx scripts/backfill-asset-thumbnails.ts",
    "sync:credits-accounts": "tsx src/db/syncCreditsAccounts.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "phase2:policy-test": "tsx src/modules/platform/accountCreationPolicyDefaults.test.ts",
    "phase3:rbac-test": "tsx src/modules/auth/rbac.test.ts",
    "phase4:user-api-test": "tsx src/modules/platform/platformUserCreation.test.ts",
    "phase7:integration-contract-test": "tsx src/modules/platform/applicationIntegrationContract.test.ts",
    "user-isolation-test": "tsx src/modules/tasks/userIsolation.test.ts",
    "kie-failure-policy-test": "tsx src/providers/kie/kieFailurePolicy.test.ts",
    "video-voice-chain-test": "tsx src/modules/video-generation/videoVoiceChain.test.ts",
    "video-template-contract-test": "tsx src/modules/video-generation/videoTemplateCatalog.test.ts",
    "video-task-lifecycle-test": "tsx src/modules/video-generation/videoTaskLifecycle.test.ts",
    "deepseek-script-contract-test": "tsx src/providers/deepseek/deepseekClient.test.ts",
    "video-prompt-assembly-test": "tsx src/modules/video-generation/videoPromptAssembly.test.ts",
    "batch-branded-scene-url-test": "tsx src/modules/batch-new/batchBrandedScene.test.ts",
    "print:application-contract-seed": "tsx scripts/print-application-contract-seed.ts",
    "phase11:smoke": "node scripts/phase11-e2e-smoke.mjs"
