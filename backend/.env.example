NODE_ENV=development
PORT=3101
PUBLIC_BASE_URL=http://localhost:3101

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=used_car_platform
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

KIE_API_KEYS=
KIE_BALANCE_STRATEGY=least_busy_round_robin
KIE_MAX_CONCURRENT_PER_KEY=100
KIE_MAX_UPLOAD_CONCURRENT=5
KIE_ACQUIRE_WAIT_TIMEOUT_MS=15000
KIE_ACQUIRE_RETRY_INTERVAL_MS=500
KIE_CREATE_TASK_URL=https://api.kie.ai/api/v1/jobs/createTask
KIE_TASK_DETAIL_URL=https://api.kie.ai/api/v1/jobs/recordInfo
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_UPLOAD_TIMEOUT_MS=30000
KIE_CREATE_TIMEOUT_MS=20000
KIE_DETAIL_TIMEOUT_MS=10000
KIE_DOWNLOAD_TIMEOUT_MS=60000
KIE_NETWORK_RETRY_LIMIT=2
KIE_NETWORK_RETRY_BASE_MS=1000
KIE_NETWORK_RETRY_MAX_MS=4000
KIE_IMAGE_DEADLINE_MS=480000
KIE_IMAGE_SOFT_TIMEOUT_MS=180000
KIE_POLL_FAILURE_LIMIT=3
KIE_FALLBACK_ENABLED=true
KIE_PRIMARY_IMAGE_MODEL=gpt-image-2-image-to-image
KIE_FALLBACK_IMAGE_MODEL=nano-banana-2
KIE_FALLBACK_OUTPUT_FORMAT=jpg

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=2000

CREDITS_PLATFORM_ENABLED=false
CREDITS_PLATFORM_BASE_URL=http://127.0.0.1:3000
CREDITS_APPLICATION_CODE=used-car-platform
CREDITS_DEFAULT_USER_ID=
CREDITS_DEFAULT_ACCOUNT_SCOPE=personal
CREDITS_DEFAULT_TENANT_ID=
CREDITS_REQUEST_TIMEOUT_MS=8000
CREDITS_MYSQL_HOST=127.0.0.1
CREDITS_MYSQL_PORT=3310
CREDITS_MYSQL_DATABASE=credits_platform
CREDITS_MYSQL_USER=credits
CREDITS_MYSQL_PASSWORD=credits
CREDITS_MYSQL_CONNECTION_LIMIT=5

UPLOAD_DIR=storage/uploads
RESULTS_DIR=storage/results
PACKAGES_DIR=storage/packages
MAX_UPLOAD_MB=20
